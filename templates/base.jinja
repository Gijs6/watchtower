{% extends "skeleton.jinja" %}

{% macro nav_link(endpoint, label) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>
        {{ label }}
        {% if caller %}{{ caller() }}{% endif %}
    </a>
{% endmacro %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">{% include "mark.svg" %}Watchtower</a>
            <nav class="navbar__links" aria-label="Main">
                {{ nav_link('watcher.index', 'Dashboard') }}

                {% call nav_link('watcher.notifications', 'Notifications') %}
                    {% include "watcher/islands/notif_badge.jinja" %}
                {% endcall %}

                {% call nav_link('watcher.settings', 'Settings') %}
                    {% if not discord_webhook_set %}
                        <span class="nav-warn tooltip"
                              data-tooltip="No Discord webhook set, notifications will not be sent">!</span>
                    {% endif %}
                {% endcall %}

                <form method="post" action="{{ url_for('logout') }}">
                    <button type="submit">Sign out</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="page">
        {% block content %}{% endblock %}
    </main>
{% endblock %}
