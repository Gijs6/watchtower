{% extends "skeleton.jinja" %}
{% from "_macros.jinja" import icon %}

{% block body_class %}page page--sidebar is-drawer{% endblock %}

{% macro nav_link(endpoint, label, name) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>
        {{ icon(name) }} <span>{{ label }}</span>
        {% if caller %}{{ caller() }}{% endif %}
    </a>
{% endmacro %}

{% block body_content %}
    <header class="app-bar">
        <button type="button" class="app-bar__menu-toggle" aria-label="Menu">{{ icon("menu") }}</button>
        <a href="{{ url_for('index') }}" class="wordmark">
            <span class="wordmark__mark">{{ icon("tower-control") }}</span>
            <span class="wordmark__text">Watchtower</span>
        </a>
    </header>

    <div class="page__body">
        <aside class="page__aside">
            <nav class="side-nav" aria-label="Main navigation">
                {{ nav_link('watcher.index', 'Dashboard', 'house') }}

                {% call nav_link('watcher.notifications', 'Notifications', 'bell') %}
                    {% include "watcher/islands/notif_badge.jinja" %}
                {% endcall %}

                {% call nav_link('watcher.settings', 'Settings', 'settings') %}
                    {% if not discord_webhook_set %}
                        <span class="side-nav__warn tooltip"
                              data-tooltip="No Discord webhook set, notifications will not be sent">
                            {{ icon("triangle-alert") }}
                        </span>
                    {% endif %}
                {% endcall %}

                <div class="side-nav__spacer"></div>

                <form method="post" action="{{ url_for('logout') }}">
                    <button type="submit">{{ icon("log-out") }} <span>Sign out</span></button>
                </form>
            </nav>
        </aside>

        <main class="page__main">
            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}
