{% extends "skeleton.jinja" %}

{% macro nav_link(endpoint, label, name) %}
    <a href="{{ url_for(endpoint) }}"
       {% if request.endpoint == endpoint %}aria-current="page"{% endif %}>
        <span>{{ label }}</span>
        {% if caller %}{{ caller() }}{% endif %}
    </a>
{% endmacro %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">Watchtower</a>
            <nav class="navbar__links" aria-label="Main navigation">
                {{ nav_link('watcher.index', 'Dashboard', 'house') }}

                {% call nav_link('watcher.notifications', 'Notifications', 'bell') %}
                    {% include "watcher/islands/notif_badge.jinja" %}

                {% endcall %}

                {% call nav_link('watcher.settings', 'Settings', 'settings') %}
                    {% if not discord_webhook_set %}
                        <span class="nav-warn tooltip"
                              data-tooltip="No Discord webhook set, notifications will not be sent">!</span>
                    {% endif %}
                {% endcall %}

                <form method="post" action="{{ url_for('logout') }}">
                    <button type="submit">
                        <span>Sign out</span>
                    </button>
                </form>
            </nav>
        </div>
    </header>

    <main class="page">
        {% block content %}{% endblock %}
    </main>

    <footer class="footer">
        <p>
            <a href="{{ url_for('index') }}">Watchtower</a> by <a href="https://gijs6.nl">Gijs6</a>
        </p>
        <p>
            <a href="https://unlicense.org" rel="license">Unlicensed</a>
        </p>
    </footer>
{% endblock %}
