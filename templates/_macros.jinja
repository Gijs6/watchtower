{# djlint:off #}
{% macro when(value, live="ago") -%}
    {%- if value is none -%}
        Never
    {%- else -%}
        <time datetime="{{ value | to_iso }}">{{ value | strftime }}</time>{% if live == "ago" %} (<time datetime="{{ value | to_iso }}" data-live="ago">{{ value | timeago }}</time>){% elif live == "until" %} (<time datetime="{{ value | to_iso }}" data-live="until">{{ value | timeuntil }}</time>){% endif %}
    {%- endif -%}
{%- endmacro %}

{% macro clock(value) -%}
    <time datetime="{{ value | to_iso }}">{{ value | strftime("%H:%M" if value | is_recent(24) else "%-d %b %Y, %H:%M") }}</time>
{%- endmacro %}
{# djlint:on #}

{% macro status_badge(status, in_title=false) -%}
    {%- set tone = {"up": " status--ok", "down": " status--bad"}.get(status, "") -%}
    {%- set label = {"up": "Up", "down": "Down", "paused": "Paused", "pending": "Pending"}[status] -%}
    {%- if in_title -%}
        <span class="status{{ tone }}">({{ label | lower }})</span>
    {%- else -%}
        <span class="status{{ tone }}">{{ label }}</span>
    {%- endif -%}
{%- endmacro %}
