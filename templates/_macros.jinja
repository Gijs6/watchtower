{% macro icon(name, cls="") -%}
    <svg class="icon{% if cls %} {{ cls }}{% endif %}"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        {% include "icons/" ~ name ~ ".svg" %}

    </svg>
{%- endmacro %}

{% macro status_badge(status) -%}
    {%- set tone = {"up": " badge--ok", "down": " badge--warn"}.get(status, "") -%}
    {%- set label = {"up": "Up", "down": "Down", "paused": "Paused", "pending": "Pending"}[status] -%}
    {%- set glyph = {"up": "circle-check", "down": "triangle-alert", "paused": "pause", "pending": "clock"}[status] -%}
    <span class="badge{{ tone }}">{{ icon(glyph) }} {{ label }}</span>
{%- endmacro %}
