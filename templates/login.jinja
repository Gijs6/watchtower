{% extends "skeleton.jinja" %}

{% from "_macros.jinja" import icon %}

{% block title %}Sign in{% endblock %}
{% block body_class %}page page--centered{% endblock %}

{% block body_content %}
    <main class="page__main auth">
        <span class="auth__brand">{{ icon("tower-control") }} Watchtower</span>

        <form method="POST" action="{{ url_for('login') }}" class="form auth__form">
            <div class="field">
                <label class="field__label" for="password">Password</label>
                <input class="field__control field__control--full"
                       type="password"
                       id="password"
                       name="password"
                       required
                       autofocus
                       autocomplete="current-password" />
            </div>
            <div class="form__actions">
                <button type="submit" class="button">{{ icon("log-in") }} Sign in</button>
            </div>
        </form>
    </main>
{% endblock %}
