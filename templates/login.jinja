{% extends "skeleton.jinja" %}

{% block title %}Sign in{% endblock %}

{% block body_content %}
    <header class="navbar">
        <div class="navbar__inner">
            <a href="{{ url_for('index') }}" class="navbar__brand">{% include "mark.svg" %}Watchtower</a>
        </div>
    </header>

    <main class="page page--narrow">
        <div class="page-head">
            <h1>Sign in</h1>
        </div>

        <form method="POST" action="{{ url_for('login') }}">
            {% if config.DEBUG %}
                <p class="muted">Dev mode, so no password is needed.</p>
            {% else %}
                <div class="field">
                    <label class="field__label" for="password">Password</label>
                    <input type="password"
                           id="password"
                           name="password"
                           required
                           autofocus
                           autocomplete="current-password" />
                </div>
            {% endif %}
            <div class="form__actions">
                <button type="submit" class="btn">Sign in</button>
            </div>
        </form>
    </main>
{% endblock %}
