{% extends "base.jinja" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Dashboard</h1>
    </div>

    {% if not discord_webhook_set %}
        <p class="alert alert--warning">
            No Discord webhook set, notifications won't be sent. <a href="{{ url_for('watcher.settings') }}">Set one in settings</a>.
        </p>
    {% endif %}

    {% include "watcher/islands/sites.jinja" %}

{% endblock %}
