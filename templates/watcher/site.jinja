{% extends "base.jinja" %}

{% from "_macros.jinja" import status_badge, when %}

{% block title %}{{ site.name }}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>{{ site.name }} {{ status_badge(status, in_title=true) }}</h1>
    </div>

    <p class="site-summary">
        <a href="{{ site.url }}" target="_blank" rel="noopener noreferrer">{{ site.url }}</a>, checked every {{ site.check_interval }} seconds, last checked {{ when(site.last_checked_at) }}.
    </p>

    <div class="form__actions site-actions">
        <a href="{{ site.url }}"
           class="btn"
           target="_blank"
           rel="noopener noreferrer">Visit</a>
        <form method="post"
              action="{{ url_for('watcher.delete', site_id=site.id) }}"
              onsubmit="return confirm('Delete {{ site.name }}?')">
            <button type="submit" class="btn btn--danger">Delete site</button>
        </form>
    </div>

    <form method="post"
          action="{{ url_for('watcher.update', site_id=site.id) }}">
        <fieldset class="fieldset">
            <legend>Site settings</legend>
            <div class="field">
                <label class="field__label" for="name">Name</label>
                <input type="text" id="name" name="name" value="{{ site.name }}" required />
            </div>
            <div class="field">
                <label class="field__label" for="url">URL</label>
                <input type="url" id="url" name="url" value="{{ site.url }}" required />
            </div>
            <div class="field field--narrow">
                <label class="field__label" for="check_interval">Check interval (seconds)</label>
                <input type="number"
                       id="check_interval"
                       name="check_interval"
                       value="{{ site.check_interval }}"
                       min="10"
                       max="86400" />
            </div>
            <div class="form__actions">
                <button type="submit" class="btn">Save settings</button>
            </div>
        </fieldset>
    </form>

    {% include "watcher/islands/history.jinja" %}

{% endblock %}
