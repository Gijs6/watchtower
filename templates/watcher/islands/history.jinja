{% from "_macros.jinja" import when %}
<section class="panel check-history"
         id="history-island"
         hx-get="{{ url_for('watcher.history_island', site_id=site.id) }}"
         hx-trigger="every 10s [!this.querySelector('details[open]')]"
         hx-swap="outerHTML">
    <h2 class="panel__heading">Change history</h2>

    {% if not snapshots %}
        <div class="empty">
            <p class="empty__title">No checks yet</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Result</th>
                        <th>When</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for snap, count, oldest in snapshots %}
                        <tr>
                            <td>
                                {% if snap.outcome == "error" %}
                                    <span class="status status--warn">Error</span>
                                    {% if count > 1 %}<span class="count">{{ "{:,}".format(count) }}</span>{% endif %}
                                {% elif snap.outcome == "changed" %}
                                    <span class="status status--bad">Changed</span>
                                {% else %}
                                    <span class="status status--ok">No change</span>
                                    {% if count > 1 %}<span class="count">{{ "{:,}".format(count) }}</span>{% endif %}
                                {% endif %}
                            </td>
                            <td class="check-history__time">
                                {%- if count > 1 -%}
                                    {{ when(oldest.captured_at, live="abs") }} → {{ when(snap.captured_at, live="abs") }}
                                {%- else -%}
                                    {{ when(snap.captured_at, live="abs") }}
                                {%- endif -%}
                            </td>
                            <td class="check-history__details">
                                {% if snap.outcome == "error" %}
                                    <span class="check-history__error">{{ snap.error }}</span>
                                {% elif snap.outcome == "changed" and snap.diff_snippet %}
                                    <details class="diff-disclosure">
                                        <summary>Show diff</summary>
                                        {{ snap.diff_snippet | diff_html }}
                                    </details>
                                {% elif snap.outcome == "changed" %}
                                    <span class="muted">Change detected, diff not available.</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
