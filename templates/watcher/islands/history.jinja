{% from "_macros.jinja" import icon %}
<section class="check-history"
         id="history-island"
         hx-get="{{ url_for('watcher.history_island', site_id=site.id) }}"
         hx-trigger="every 10s"
         hx-swap="outerHTML">
    <h2>Change history</h2>

    {% if not snapshots %}
        <div class="empty empty--plain">
            <p class="empty__text">No checks recorded yet.</p>
        </div>
    {% else %}
        <ol class="check-history__list">
            {% for snap, count, oldest in snapshots %}
                <li class="check-history__entry check-history__entry--{{ snap.outcome }}">
                    <div class="check-history__head">
                        <span class="check-history__dot" aria-hidden="true"></span>
                        <span class="check-history__time">
                            {%- if count > 1 -%}
                                {{ oldest.captured_at | strftime }} to {{ snap.captured_at | strftime }}
                            {%- else -%}
                                {{ snap.captured_at | strftime }}
                            {%- endif -%}
                        </span>
                        {% if snap.outcome == "error" %}
                            <span class="badge badge--warn">{{ icon("triangle-alert") }} Error
                                {% if count > 1 %}&times;{{ count }}{% endif %}
                            </span>
                        {% elif snap.outcome == "changed" %}
                            <span class="badge badge--bad">{{ icon("zap") }} Changed</span>
                        {% else %}
                            <span class="badge badge--ok">{{ icon("check") }} No change
                                {% if count > 1 %}&times;{{ count }}{% endif %}
                            </span>
                        {% endif %}
                    </div>

                    {% if snap.outcome == "error" %}
                        <p class="check-history__error">{{ snap.error }}</p>
                    {% elif snap.outcome == "changed" and snap.diff_snippet %}
                        <details class="diff-disclosure">
                            <summary>{{ icon("chevron-down") }} Show diff</summary>
                            {{ snap.diff_snippet | diff_html }}
                        </details>
                    {% elif snap.outcome == "changed" %}
                        <p class="check-history__note">Change detected, diff not available.</p>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</section>
