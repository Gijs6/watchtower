<span id="notif-badge"
      class="side-nav__badge"
      hx-get="{{ url_for('watcher.notif_badge') }}"
      hx-trigger="every 30s"
      hx-swap="outerHTML">
    {% if notification_count > 0 %}<span class="count count--bad" aria-label="{{ notification_count }} unread">{{ notification_count }}</span>{% endif %}
</span>
