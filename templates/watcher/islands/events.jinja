{% from "_macros.jinja" import when %}
<section class="panel check-history"
         id="events-island"
         hx-get="{{ url_for('watcher.events_island') }}"
         hx-trigger="every 30s"
         data-pause-when-open
         hx-swap="outerHTML">
    <h2 class="panel__heading">Changes</h2>
    {% if not events %}
        <div class="empty">
            <p class="empty__title">No changes detected yet</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>When</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for snap in events %}
                        <tr>
                            <td>
                                <a href="{{ url_for('watcher.detail', site_id=snap.site_id) }}"
                                   class="check-history__site">{{ snap.site.name }}</a>
                            </td>
                            <td class="check-history__time">{{ when(snap.captured_at) }}</td>
                            <td class="check-history__details">
                                {% if snap.diff_snippet %}
                                    <details class="diff-disclosure">
                                        <summary>Show diff</summary>
                                        {{ snap.diff_snippet | diff_html }}
                                    </details>
                                {% else %}
                                    <span class="muted">Change detected, diff not available.</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
