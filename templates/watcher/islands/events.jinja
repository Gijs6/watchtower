{% from "_macros.jinja" import icon %}
<section class="check-history"
         id="events-island"
         hx-get="{{ url_for('watcher.events_island') }}"
         hx-trigger="every 30s"
         hx-swap="outerHTML">
    {% if not events %}
        <div class="empty">
            {{ icon("bell", "empty__icon") }}
            <p class="empty__title">No changes detected yet</p>
            <p class="empty__text">When a monitored page changes, it shows up here.</p>
        </div>
    {% else %}
        <ol class="check-history__list">
            {% for snap in events %}
                <li class="check-history__entry check-history__entry--changed">
                    <div class="check-history__head">
                        <span class="check-history__dot" aria-hidden="true"></span>
                        <a href="{{ url_for('watcher.detail', site_id=snap.site_id) }}"
                           class="check-history__site">{{ snap.site.name }}</a>
                        <time class="check-history__time"
                              data-live
                              datetime="{{ snap.captured_at | to_iso }}">
                            {{ snap.captured_at | strftime }}
                        </time>
                    </div>
                    {% if snap.diff_snippet %}
                        <details class="diff-disclosure">
                            <summary>{{ icon("chevron-down") }} Show diff</summary>
                            {{ snap.diff_snippet | diff_html }}
                        </details>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}
</section>
