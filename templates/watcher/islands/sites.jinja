{% from "_macros.jinja" import status_badge, when %}
<div id="sites-island"
     class="panel"
     hx-get="{{ url_for('watcher.island') }}"
     hx-trigger="every 10s"
     hx-swap="outerHTML">
    <h2 class="panel__heading">
        Sites <a href="{{ url_for('watcher.add_site') }}" class="btn btn--sm">Add site</a>
    </h2>
    {% if not sites %}
        <div class="empty">
            <p class="empty__title">No sites yet</p>
            <p>Add one with the button above and Watchtower starts checking it.</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Status</th>
                        <th>Last 24 hours</th>
                        <th>Checked</th>
                        <th>Changed</th>
                        <th>Next check</th>
                        <th class="table__actions">
                            <span class="visually-hidden">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in sites %}
                        <tr>
                            <td class="site-cell">
                                <a href="{{ url_for('watcher.detail', site_id=site.id) }}"
                                   class="site-cell__name">{{ site.name }}</a>
                                <a href="{{ site.url }}"
                                   class="site-cell__url"
                                   target="_blank"
                                   rel="noopener noreferrer">{{ site.url }}</a>
                            </td>
                            <td>
                                {{ status_badge(status[site.id]) }}
                                {% if site.last_changed_at and site.last_changed_at | is_recent %}<small class="site-cell__flag">Changed {{ site.last_changed_at | timeago }}</small>{% endif %}
                            </td>
                            <td>
                                <div class="timeline" aria-label="Last 24 hours">
                                    {% for bucket in timeline[site.id] %}
                                        {% set h_near = 23 - loop.index0 %}
                                        {% set h_far = 24 - loop.index0 %}
                                        {% set when = "last hour" if h_near == 0 else h_near ~ "-" ~ h_far ~ "h ago" %}
                                        {% if bucket is none %}
                                            {% set level = "empty" %}
                                            {% set tip = "No data, " ~ when %}
                                        {% else %}
                                            {% if bucket.changes %}
                                                {% set level = "changed" %}
                                            {% elif bucket.errors %}
                                                {% set level = "error" %}
                                            {% else %}
                                                {% set level = "ok" %}
                                            {% endif %}
                                            {% set change_text = "" if not bucket.changes else ("1 change" if bucket.changes == 1 else bucket.changes ~ " changes") %}
                                            {% set error_text = "" if not bucket.errors else ("1 error" if bucket.errors == 1 else bucket.errors ~ " errors") %}
                                            {% if change_text and error_text %}
                                                {% set tip = change_text ~ ", " ~ error_text ~ ", " ~ when %}
                                            {% elif change_text %}
                                                {% set tip = change_text ~ ", " ~ when %}
                                            {% elif error_text %}
                                                {% set tip = error_text ~ ", " ~ when %}
                                            {% else %}
                                                {% set tip = "No changes, " ~ when %}
                                            {% endif %}
                                        {% endif %}
                                        <span class="tl-bar tl-bar--{{ level }} tooltip" data-tooltip="{{ tip }}"></span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="site-cell__time">{{ when(site.last_checked_at) }}</td>
                            <td class="site-cell__time">{{ when(site.last_changed_at) }}</td>
                            <td class="site-cell__time">
                                {% if site.is_active %}
                                    {{ when(site.next_check_at, live="until") }}
                                {%- else %}Paused
                                {% endif %}
                            </td>
                            <td class="table__actions">
                                <form method="post"
                                      action="{{ url_for('watcher.toggle', site_id=site.id) }}">
                                    <button type="submit" class="btn btn--sm">
                                        {% if site.is_active %}
                                            Pause
                                        {%- else %}Resume
                                        {% endif %}
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
