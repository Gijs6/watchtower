{% extends "base.jinja" %}

{% block title %}Add site{% endblock %}

{% block content %}
    <ol class="breadcrumb" aria-label="Breadcrumb">
        <li>
            <a href="{{ url_for('watcher.index') }}">Dashboard</a>
        </li>
        <li>
            <span aria-current="page">Add site</span>
        </li>
    </ol>

    <div class="page-head">
        <h1>Add site</h1>
    </div>

    <form method="post" action="{{ url_for('watcher.add') }}">
        <div class="field">
            <label class="field__label" for="site-name">Name</label>
            <input type="text"
                   id="site-name"
                   name="name"
                   placeholder="Generated from the URL"
                   value="{{ name or '' }}" />
        </div>
        <div class="field">
            <label class="field__label" for="site-url">URL</label>
            <input type="url"
                   id="site-url"
                   name="url"
                   placeholder="https://example.com"
                   value="{{ url or '' }}"
                   required />
        </div>
        <div class="field field--narrow">
            <label class="field__label" for="site-interval">Check interval (seconds)</label>
            <input type="number"
                   id="site-interval"
                   name="check_interval"
                   value="{{ interval or 300 }}"
                   min="10"
                   max="86400" />
        </div>
        <div class="form__actions">
            <button type="submit" class="btn">Add</button>
        </div>
    </form>
{% endblock %}
