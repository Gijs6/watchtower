{% extends "base.jinja" %}

{% block title %}Settings{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Settings</h1>
    </div>

    <form method="post" action="{{ url_for('watcher.settings_save') }}">
        <fieldset class="fieldset">
            <legend>Notifications</legend>
            <div class="field">
                <label class="field__label" for="discord_webhook">Discord webhook URL</label>
                <input type="url"
                       id="discord_webhook"
                       name="discord_webhook"
                       value="{{ webhook }}"
                       placeholder="https://discord.com/api/webhooks/..." />
                <p class="field__hint">Watchtower sends a message to this webhook when a monitored page changes.</p>
            </div>
            <div class="form__actions">
                <button type="submit" class="btn">Save settings</button>
            </div>
        </fieldset>
    </form>
{% endblock %}
