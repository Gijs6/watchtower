<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{%- block title -%}{%- endblock %} - Watchtower</title>

        <link rel="icon"
              href="{{ url_for('static', filename='favicon.svg') }}"
              type="image/svg+xml" />
        <link rel="alternate icon"
              href="{{ url_for('static', filename='favicon.ico') }}" />

        {% set theme = "http://localhost:8000/theme/v2" if config.DEBUG else "https://cdn.gijs6.nl/theme/v2" %}
        <link rel="stylesheet" href="{{ theme }}/all.css" />
        <link rel="stylesheet" href="{{ theme }}/accent/orange.css" />
        {% if config.DEBUG %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.css') }}" />
        {% else %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.min.css') }}" />
        {% endif %}

        <script src="{{ url_for('static', filename='vendor/htmx.min.js') }}" defer></script>
        <script src="{{ theme }}/js/toast.js" defer></script>

        {% block extra_headers %}{% endblock %}
    </head>

    <body class="app {% block body_class %}{% endblock %}">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="toaster" aria-live="polite">
                    {% for category, message in messages %}
                        {% set kind = "success" if category == "success" else "danger" if category == "error" else "info" %}
                        <div class="toast toast--{{ kind }}"
                             role="status"
                             data-auto-dismiss="6000">
                            <div class="toast__body">{{ message }}</div>
                            <button type="button" class="toast__dismiss" aria-label="Dismiss">&times;</button>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        {% block body_content %}{% endblock %}

        <script>
            const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            function span(s) {
                const units = [[60, 1, 'second'], [3600, 60, 'minute'], [86400, 3600, 'hour'], [604800, 86400, 'day'], [2629800, 604800, 'week'], [31557600, 2629800, 'month'], [Infinity, 31557600, 'year']];
                for (const [limit, size, unit] of units) {
                    if (s < limit) {
                        const n = Math.floor(s / size);
                        return n + ' ' + unit + (n === 1 ? '' : 's');
                    }
                }
            }

            function timeago(dt) {
                const s = Math.floor((Date.now() - dt) / 1000);
                return s < 0 ? 'in ' + span(-s) : span(s) + ' ago';
            }

            function timeuntil(dt) {
                const s = Math.floor((dt - Date.now()) / 1000);
                return s <= 0 ? 'due now' : 'in ' + span(s);
            }

            function absolute(dt) {
                const pad = (n) => String(n).padStart(2, '0');
                return dt.getDate() + ' ' + MONTHS[dt.getMonth()] + ' ' + dt.getFullYear() + ', ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
            }

            function updateLiveTimes() {
                document.querySelectorAll('time[data-live]').forEach(function(el) {
                    const dt = new Date(el.getAttribute('datetime'));
                    if (isNaN(dt)) return;
                    const mode = el.dataset.live;
                    if (mode === 'abs') el.textContent = absolute(dt);
                    else if (mode === 'until') el.textContent = absolute(dt) + ' (' + timeuntil(dt) + ')';
                    else el.textContent = absolute(dt) + ' (' + timeago(dt) + ')';
                });
            }
            updateLiveTimes();
            setInterval(updateLiveTimes, 1000);
            document.addEventListener('htmx:afterSettle', updateLiveTimes);
        </script>
    </body>
</html>
