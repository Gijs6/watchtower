{% from "_macros.jinja" import icon %}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{%- block title -%}{%- endblock %} - Watchtower</title>

        <link rel="icon"
              href="{{ url_for('static', filename='favicon.svg') }}"
              type="image/svg+xml" />
        <link rel="alternate icon"
              href="{{ url_for('static', filename='favicon.ico') }}" />

        <link rel="stylesheet" href="https://cdn.gijs6.nl/theme/v1/all.css" />
        <link rel="stylesheet"
              href="https://cdn.gijs6.nl/theme/v1/accent/orange.css" />
        {% if config.DEBUG %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.css') }}" />
        {% else %}
            <link rel="stylesheet"
                  href="{{ url_for('static', filename='styles/app.min.css') }}" />
        {% endif %}

        <script src="{{ url_for('static', filename='vendor/htmx.min.js') }}" defer></script>
        <script src="https://cdn.gijs6.nl/theme/v1/js/toast.js" defer></script>
        <script src="https://cdn.gijs6.nl/theme/v1/js/nav.js" defer></script>

        {% block extra_headers %}{% endblock %}
    </head>

    <body class="{% block body_class %}{% endblock %}">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="toaster" aria-live="polite">
                    {% for category, message in messages %}
                        {% set kind = "success" if category == "success" else "danger" if category == "error" else "info" %}
                        <div class="toast toast--{{ kind }}"
                             role="status"
                             data-auto-dismiss="6000">
                            {% if kind == "success" %}
                                {{ icon('circle-check', 'toast__icon') }}
                            {%- elif kind == "danger" %}{{ icon('triangle-alert', 'toast__icon') }}
                            {%- else %}{{ icon('info', 'toast__icon') }}
                            {% endif %}
                            <div class="toast__body">{{ message }}</div>
                            <button type="button" class="toast__dismiss" aria-label="Dismiss">{{ icon("x") }}</button>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        {% block body_content %}{% endblock %}

        <script>
            function timeago(dt) {
                let s = Math.floor((Date.now() - dt) / 1000);
                const future = s < 0;
                s = Math.abs(s);
                let span;
                if (s < 60) span = s + 's';
                else if (s < 3600) span = Math.floor(s / 60) + 'm';
                else if (s < 86400) span = Math.floor(s / 3600) + 'h';
                else span = Math.floor(s / 86400) + 'd';
                return future ? 'in ' + span : span + ' ago';
            }

            function timeuntil(dt) {
                let s = Math.floor((dt - Date.now()) / 1000);
                if (s <= 0) return 'due now';
                let span;
                if (s < 60) span = s + 's';
                else if (s < 3600) span = Math.floor(s / 60) + 'm';
                else if (s < 86400) span = Math.floor(s / 3600) + 'h';
                else span = Math.floor(s / 86400) + 'd';
                return 'in ' + span;
            }

            function updateLiveTimes() {
                document.querySelectorAll('time[data-live]').forEach(function(el) {
                    const dt = new Date(el.getAttribute('datetime'));
                    if (isNaN(dt)) return;
                    el.textContent = el.dataset.live === 'until' ? timeuntil(dt) : timeago(dt);
                });
            }
            updateLiveTimes();
            setInterval(updateLiveTimes, 1000);
            document.addEventListener('htmx:afterSettle', updateLiveTimes);
        </script>
    </body>
</html>
